{
  "name": "bingo-kit",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://evilnanan.github.io/bingo-kit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npx tsx party/dev-server.ts",
    "dev:party": "npx partykit dev",
    "predeploy": "npm run buildgh",
    "deploy": "gh-pages -d dist",
    "deploy:party": "partykit deploy",
    "deploy:images": "wrangler deploy --config image-worker/wrangler.json",
    "build": "tsc -b && vite build",
    "buildgh": "tsc -b && vite build --base /bingo-kit/",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"party/**/*.ts\""
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "papaparse": "^5.5.3",
    "partysocket": "^1.1.19",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "partykit": "^0.0.115",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.117.0",
    "ws": "^8.21.0"
  }
}
